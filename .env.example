# =============================================================================
# Environment Variables Template
# Copy this file to .env.local for local development.
# Set these as Environment Variables in your Vercel project for production.
# Do NOT commit .env or .env.local — they are in .gitignore.
# =============================================================================

# --- Database (Neon PostgreSQL) -----------------------------------------------
# Get this from: https://console.neon.tech → your project → Connection string
# Use the "Pooled connection" string (port 5432, ?pgbouncer=true&connect_timeout=10)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_NAME="Glitrai"

# --- API ----------------------------------------------------------------------
# Generate a strong random secret: openssl rand -hex 32
API_SECRET_KEY=""

# --- Gemini -------------------------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# --- Cloudinary ---------------------------------------------------------------
# Get from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Node (do not set manually on Vercel — it sets this automatically) --------
# NODE_ENV="production"
