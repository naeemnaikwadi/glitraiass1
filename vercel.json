{
  "framework": "nextjs",
  "buildCommand": "prisma migrate resolve --applied 0_init || echo 'Already baselined' && prisma migrate deploy && next build",
  "installCommand": "npm install",
  "functions": {
    "app/api/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/jobs/route.ts": {
      "maxDuration": 15
    },
    "app/api/jobs/[id]/route.ts": {
      "maxDuration": 15
    },
    "app/api/health/route.ts": {
      "maxDuration": 10
    }
  }
}
